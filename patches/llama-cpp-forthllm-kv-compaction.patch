diff --git a/include/llama-forthllm.h b/include/llama-forthllm.h
new file mode 100644
index 000000000..1db277305
--- /dev/null
+++ b/include/llama-forthllm.h
@@ -0,0 +1,176 @@
+#pragma once
+
+#include "llama.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+//
+// ForthLLM: chunked context compression
+//
+// Old prompt chunks (C tokens) are replaced by a small number (S << C) of KV summary
+// rows. Each summary row is a weighted combination of the chunk's K/V rows (per layer,
+// per KV head), so the row shape is preserved and the attention graph is untouched: an
+// old chunk occupies S KV cells instead of C, and the KV cache stops growing linearly
+// with context.
+//
+// llama_forthllm_compact() performs the KV-cache surgery (read rows, summarize, write
+// back, free cells, shift positions). The model-agnostic math (summarization, chunk
+// stack, squeezer, BWT) is in the C++ section below and is exercised by
+// tests/test-forthllm.cpp.
+
+#ifdef __cplusplus
+
+struct llama_forthllm_config {
+    int32_t chunk_size      = 128;   // tokens per chunk
+    int32_t summary_dim     = 1;     // number of summary rows per chunk (S)
+    std::string summary_method = "attention"; // "attention" | "mean" | "last"
+    int32_t max_stack_depth = 64;    // maximum number of summarized chunks to keep
+    std::string eviction    = "lru"; // "lru" | "lfu" | "fixed-window"
+    std::string squeezer    = "none"; // "none" | "jl-bwt"
+    int32_t jl_dim          = 128;   // JL projection output dim (squeezer)
+
+    // throws std::runtime_error with a descriptive message on invalid values
+    void validate() const;
+};
+
+enum llama_forthllm_summary_method {
+    LLAMA_FORTHLLM_SUMMARY_ATTENTION = 0,
+    LLAMA_FORTHLLM_SUMMARY_MEAN      = 1,
+    LLAMA_FORTHLLM_SUMMARY_LAST      = 2,
+};
+
+// parses "attention" | "mean" | "last" (case-insensitive); throws std::runtime_error
+llama_forthllm_summary_method llama_forthllm_summary_method_from_str(const std::string & s);
+const char * llama_forthllm_summary_method_name(llama_forthllm_summary_method m);
+// parse+validate (case-insensitive) an eviction policy; returns the normalized name,
+// throws std::runtime_error on unknown
+std::string llama_forthllm_eviction_from_str(const std::string & s);
+// parse+validate (case-insensitive) a squeezer name; returns the normalized name,
+// throws std::runtime_error on unknown
+std::string llama_forthllm_squeezer_from_str(const std::string & s);
+
+// Summarize one chunk of KV rows (all KV heads of one layer) into S summary rows.
+// k: [C][n_heads_k*head_dim_k], v: [C][n_heads_v*head_dim_v], row-major
+// (head_dim_k and head_dim_v may differ; n_heads_k == n_heads_v == n_head_kv).
+//   attention: the chunk is split into S contiguous sub-chunks; for each, per-head
+//              weights w_i = softmax(k_i[h] . k_last[h] / sqrt(head_dim_k)) (last-key
+//              similarity within the sub-chunk) are applied to both K and V rows
+//   mean:      the chunk is split into S contiguous sub-chunks, each uniformly pooled
+//   last:      the last S rows are kept verbatim
+// k_out/v_out: [S][...]. S is clamped to C.
+void llama_forthllm_summarize(
+        const float * k, size_t n_heads_k, size_t head_dim_k,
+        const float * v, size_t n_heads_v, size_t head_dim_v,
+               size_t C, size_t S,
+        llama_forthllm_summary_method method,
+        std::vector<float> & k_out, std::vector<float> & v_out);
+
+// one summarized chunk on the stack
+struct llama_forthllm_chunk_info {
+    size_t chunk_id   = 0;    // prompt-order index of the chunk
+    size_t n_tokens   = 0;    // raw tokens in the chunk
+    size_t n_summary  = 0;    // summary rows in the KV cache
+    float  importance  = 1.0f; // eviction importance (higher = keep)
+};
+
+// Stack of summarized chunks with an eviction policy. When the stack exceeds
+// max_stack_depth, evict() returns the chunk_ids whose summaries should be dropped
+// from the KV cache entirely (the chunk's content leaves the context).
+//   lru:          least important (ties: oldest) — "use" is tracked by the caller
+//   lfu:          falls back to lru until per-chunk attention counts are available
+//   fixed-window: keep only the most recent max_stack_depth chunks
+class llama_forthllm_stack {
+public:
+    explicit llama_forthllm_stack(const llama_forthllm_config & cfg);
+
+    void push(const llama_forthllm_chunk_info & info);
+    std::vector<size_t> evict(); // chunk_ids to drop; may be called repeatedly
+    size_t size() const;
+    const llama_forthllm_chunk_info & at(size_t i) const;
+
+private:
+    llama_forthllm_config cfg_;
+    std::vector<llama_forthllm_chunk_info> stack_;
+};
+
+// Squeezer: compress a float vector for storage (JL projection -> 8-bit quantization
+// -> BWT). The in-cache summary rows stay head-dim; the squeezer is used for the
+// stored/offloaded representation. The JL projection is not invertible: expand()
+// returns the dequantized jl_dim-dim projection, within the quantization error.
+class llama_forthllm_squeezer {
+public:
+    explicit llama_forthllm_squeezer(size_t output_dim, uint32_t seed = 0);
+
+    // deterministic Gaussian projection (N(0, 1/output_dim)), same matrix for all
+    // calls with the same seed
+    std::vector<float> project(const std::vector<float> & embedding) const;
+
+    std::string squeeze(const std::vector<float> & embedding) const;
+    std::vector<float> expand(const std::string & compressed) const;
+
+    size_t output_dim() const;
+
+private:
+    size_t output_dim_;
+    uint32_t seed_;
+};
+
+// BWT (Burrows-Wheeler transform) over a byte string. transform is O(n^2 log n)
+// (summary-sized data only); invert is O(n log n) via the LF mapping and is exact
+// for any byte content (the original row index is stored in the blob).
+std::string llama_forthllm_bwt_transform(const std::string & input);
+std::string llama_forthllm_bwt_invert(const std::string & blob);
+
+#endif // __cplusplus
+
+//
+// C API
+//
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct llama_forthllm_params {
+    int32_t chunk_size;      // tokens per chunk (C); must be > 0
+    int32_t summary_dim;     // summary rows per chunk (S); must be > 0, clamped to C
+    const char * summary_method; // "attention" | "mean" | "last"
+    int32_t max_stack_depth; // max summarized chunks to keep (<= 0 = no limit); the
+                             // oldest chunks beyond this are dropped from the context
+    const char * eviction;   // "lru" | "lfu" | "fixed-window" (all currently drop the
+                             // oldest; importance-based eviction is future work)
+};
+
+// info about one compacted chunk (filled by llama_forthllm_compact)
+// positions are in the pre-compaction position space
+struct llama_forthllm_chunk_range {
+    llama_pos pos0;    // first position of the chunk
+    int32_t n_tokens;  // tokens in the chunk
+    int32_t n_freed;   // cells freed (n_tokens - n_summary)
+};
+
+// Compact the KV cache of seq_id: every old chunk of chunk_size tokens is replaced by
+// summary_dim summary rows (the last chunk_size tokens are kept raw), and the
+// positions after each chunk are shifted left by (C - S) so the sequence stays
+// contiguous. The keys of the shifted cells are re-rotated to their new positions by
+// the cache's K-shift mechanism on the next compute.
+//
+// Supported: full-attention caches (llama_kv_cache), flash attention enabled
+// (non-transposed V cache), KV cache on the host, single-sequence cells.
+//
+// Returns the total number of freed cells (0 if nothing was compacted), or a negative
+// value on error (a message is logged).
+// chunk_info: if non-NULL, receives one entry per compacted chunk (up to n_chunk_max).
+LLAMA_API int llama_forthllm_compact(
+        struct llama_context * ctx,
+        int32_t seq_id,
+        const struct llama_forthllm_params * params,
+        struct llama_forthllm_chunk_range * chunk_info,
+        int32_t n_chunk_max);
+
+#ifdef __cplusplus
+}
+#endif
