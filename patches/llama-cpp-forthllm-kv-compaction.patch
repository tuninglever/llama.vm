+        }
+
+        // count the reported chunks (filled entries have n_freed > 0 and are written
+        // contiguously from the start); a summarized chunk frees (C - S) but a dropped
+        // chunk frees C, so n_freed alone does not give the count
+        int32_t n_chunks = 0;
