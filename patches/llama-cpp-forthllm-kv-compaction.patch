+    // ForthLLM: compact the slot's KV cache (old chunks -> summary rows) and keep
+    // slot.prompt.tokens in sync with the compacted positions.
+    // Returns the number of freed cells, 0 if nothing was compacted, or a negative
+    // value on error. Only valid for text-only prompts (token index == position).
+    int forthllm_compact_slot(server_slot & slot) {
+        const int32_t C = params_base.forthllm.chunk_size;
+        const int32_t S = std::min(params_base.forthllm.summary_dim, C);
+        if (C <= 0 || S <= 0 || S >= C) {
+            return -1;
+        }
+
+        // one entry per compacted chunk (at most one chunk per C tokens)
+        std::vector<llama_forthllm_chunk_range> chunks(slot.prompt.tokens.size() / (size_t) C + 1);
+
+        const int n_freed = common_forthllm_compact(slot.ctx_tgt, slot.id, params_base.forthllm, chunks.data(), (int32_t) chunks.size());
+        if (n_freed <= 0) {
+            return n_freed;
+        }
+
+        // count the reported chunks (filled entries have n_freed > 0 and are written
+        // contiguously from the start); a summarized chunk frees (C - S) but a dropped
+        // chunk frees C, so n_freed alone does not give the count
+        int32_t n_chunks = 0;
+        while (n_chunks < (int32_t) chunks.size() && chunks[n_chunks].n_freed > 0) {
+            ++n_chunks;
+        }
+
+        // remove the compacted/dropped tokens from the prompt (back-to-front, so the
+        // earlier ranges keep their indices); a summarized chunk keeps its first
+        // S = n_tokens - n_freed tokens (the summary rows), a dropped chunk keeps none
+        llama_tokens new_tokens = slot.prompt.tokens.get_tokens(); // copy
+        for (int32_t i = n_chunks - 1; i >= 0; --i) {
+            const auto & cr = chunks[i];
+            const size_t keep  = (size_t) cr.n_tokens - (size_t) cr.n_freed;
+            const size_t begin = (size_t) cr.pos0 + keep;
+            const size_t end   = (size_t) cr.pos0 + (size_t) cr.n_tokens;
+            if (begin < new_tokens.size() && end <= new_tokens.size()) {
+                new_tokens.erase(new_tokens.begin() + begin, new_tokens.begin() + end);
+            }
+        }
+
+        slot.prompt.clear();
+        slot.prompt.tokens.insert(new_tokens);
+
+        slot.truncated = true;
+
+        SLT_INF(slot, "forthllm: compacted %d chunk(s), freed %d cells, prompt %d -> %d tokens\n",
+                n_chunks, n_freed, (int) (new_tokens.size() + (size_t) n_freed), (int) new_tokens.size());
+
+        return n_freed;
+    }
