diff --git a/src/forthllm.cpp b/src/forthllm.cpp
new file mode 100644
index 000000000..9ed24e2f2
--- /dev/null
+++ b/src/forthllm.cpp
@@ -0,0 +1,340 @@
+#include "llama-forthllm.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+
+void llama_forthllm_config::validate() const {
+    if (chunk_size <= 0) {
+        throw std::runtime_error("forthllm: chunk_size must be > 0");
+    }
+    if (summary_dim <= 0) {
+        throw std::runtime_error("forthllm: summary_dim must be > 0");
+    }
+    if (summary_dim > chunk_size) {
+        throw std::runtime_error("forthllm: summary_dim (" + std::to_string(summary_dim) +
+                                 ") must be <= chunk_size (" + std::to_string(chunk_size) + ")");
+    }
+    if (max_stack_depth <= 0) {
+        throw std::runtime_error("forthllm: max_stack_depth must be > 0");
+    }
+    llama_forthllm_eviction_from_str(eviction); // throws on unknown
+    llama_forthllm_squeezer_from_str(squeezer); // throws on unknown
+    if (squeezer == "jl-bwt" && jl_dim <= 0) {
+        throw std::runtime_error("forthllm: jl_dim must be > 0 when the squeezer is jl-bwt");
+    }
+    llama_forthllm_summary_method_from_str(summary_method); // throws on unknown
+}
+
+llama_forthllm_summary_method llama_forthllm_summary_method_from_str(const std::string & s) {
+    std::string l = s;
+    std::transform(l.begin(), l.end(), l.begin(), ::tolower);
+    if (l == "attention") {
+        return LLAMA_FORTHLLM_SUMMARY_ATTENTION;
+    }
+    if (l == "mean") {
+        return LLAMA_FORTHLLM_SUMMARY_MEAN;
+    }
+    if (l == "last") {
+        return LLAMA_FORTHLLM_SUMMARY_LAST;
+    }
+    throw std::runtime_error("forthllm: unknown summary method '" + s + "' (use attention|mean|last)");
+}
+
+const char * llama_forthllm_summary_method_name(llama_forthllm_summary_method m) {
+    switch (m) {
+        case LLAMA_FORTHLLM_SUMMARY_ATTENTION: return "attention";
+        case LLAMA_FORTHLLM_SUMMARY_MEAN:      return "mean";
+        case LLAMA_FORTHLLM_SUMMARY_LAST:      return "last";
+    }
+    return "unknown";
+}
+
+std::string llama_forthllm_eviction_from_str(const std::string & s) {
+    std::string l = s;
+    std::transform(l.begin(), l.end(), l.begin(), ::tolower);
+    if (l == "lru" || l == "lfu" || l == "fixed-window") {
+        return l;
+    }
+    throw std::runtime_error("forthllm: unknown eviction policy '" + s + "' (use lru|lfu|fixed-window)");
+}
+
+std::string llama_forthllm_squeezer_from_str(const std::string & s) {
+    std::string l = s;
+    std::transform(l.begin(), l.end(), l.begin(), ::tolower);
+    if (l == "none" || l == "jl-bwt") {
+        return l;
+    }
+    throw std::runtime_error("forthllm: unknown squeezer '" + s + "' (use none|jl-bwt)");
+}
+
+void llama_forthllm_summarize(
+        const float * k, size_t n_heads_k, size_t head_dim_k,
+        const float * v, size_t n_heads_v, size_t head_dim_v,
+               size_t C, size_t S,
+        llama_forthllm_summary_method method,
+        std::vector<float> & k_out, std::vector<float> & v_out) {
+    if (C == 0 || S == 0) {
+        k_out.clear();
+        v_out.clear();
+        return;
+    }
+    S = std::min(S, C);
+    const size_t kv_dim_k = n_heads_k * head_dim_k;
+    const size_t kv_dim_v = n_heads_v * head_dim_v;
+    k_out.assign(S * kv_dim_k, 0.0f);
+    v_out.assign(S * kv_dim_v, 0.0f);
+
+    if (method == LLAMA_FORTHLLM_SUMMARY_LAST) {
+        for (size_t s = 0; s < S; ++s) {
+            const size_t i = C - S + s;
+            std::memcpy(&k_out[s * kv_dim_k], &k[i * kv_dim_k], kv_dim_k * sizeof(float));
+            std::memcpy(&v_out[s * kv_dim_v], &v[i * kv_dim_v], kv_dim_v * sizeof(float));
+        }
+        return;
+    }
+
+    // split the chunk into S contiguous sub-chunks (even split; the boundaries are
+    // floor(i*C/S) so every sub-chunk is non-empty); pool each sub-chunk with
+    // per-head weights (head h's K and V rows are pooled with head h's weights)
+    for (size_t s = 0; s < S; ++s) {
+        const size_t i0 = (s * C) / S;
+        const size_t i1 = ((s + 1) * C) / S;
+        const size_t n  = i1 - i0;
+
+        // per-head weights from the K rows (last-key similarity within the
+        // sub-chunk: the sub-chunk's last key stands in for the query, so rows
+        // similar to it get the most weight)
+        std::vector<std::vector<float>> W(n_heads_k, std::vector<float>(n, 1.0f / (float) n));
+        if (method == LLAMA_FORTHLLM_SUMMARY_ATTENTION) {
+            for (size_t h = 0; h < n_heads_k; ++h) {
+                const float * q = &k[(i1 - 1) * kv_dim_k + h * head_dim_k];
+                float max_score = -INFINITY;
+                for (size_t i = 0; i < n; ++i) {
+                    const float * kr = &k[(i0 + i) * kv_dim_k + h * head_dim_k];
+                    float dot = 0.0f;
+                    for (size_t j = 0; j < head_dim_k; ++j) {
+                        dot += kr[j] * q[j];
+                    }
+                    W[h][i] = dot / std::sqrt((float) head_dim_k);
+                    max_score = std::max(max_score, W[h][i]);
+                }
+                float sum = 0.0f;
+                for (size_t i = 0; i < n; ++i) {
+                    W[h][i] = std::exp(W[h][i] - max_score);
+                    sum += W[h][i];
+                }
+                for (size_t i = 0; i < n; ++i) {
+                    W[h][i] /= sum;
+                }
+            }
+        }
+
+        for (size_t h = 0; h < n_heads_k; ++h) {
+            for (size_t j = 0; j < head_dim_k; ++j) {
+                float ak = 0.0f;
+                for (size_t i = 0; i < n; ++i) {
+                    ak += W[h][i] * k[(i0 + i) * kv_dim_k + h * head_dim_k + j];
+                }
+                k_out[s * kv_dim_k + h * head_dim_k + j] = ak;
+            }
+        }
+        for (size_t h = 0; h < n_heads_v; ++h) {
+            for (size_t j = 0; j < head_dim_v; ++j) {
+                float av = 0.0f;
+                for (size_t i = 0; i < n; ++i) {
+                    av += W[h][i] * v[(i0 + i) * kv_dim_v + h * head_dim_v + j];
+                }
+                v_out[s * kv_dim_v + h * head_dim_v + j] = av;
+            }
+        }
+    }
+}
+
+llama_forthllm_stack::llama_forthllm_stack(const llama_forthllm_config & cfg) : cfg_(cfg) {}
+
+void llama_forthllm_stack::push(const llama_forthllm_chunk_info & info) {
+    stack_.push_back(info);
+}
+
+std::vector<size_t> llama_forthllm_stack::evict() {
+    std::vector<size_t> to_drop;
+    if (stack_.size() <= (size_t) cfg_.max_stack_depth) {
+        return to_drop;
+    }
+    if (cfg_.eviction == "fixed-window") {
+        // keep only the most recent max_stack_depth chunks
+        const size_t n_drop = stack_.size() - (size_t) cfg_.max_stack_depth;
+        for (size_t i = 0; i < n_drop; ++i) {
+            to_drop.push_back(stack_[i].chunk_id);
+        }
+        stack_.erase(stack_.begin(), stack_.begin() + n_drop);
+        return to_drop;
+    }
+    // lru (and lfu, which falls back to lru until per-chunk attention counts are
+    // available): drop the least important, ties broken by oldest
+    while (stack_.size() > (size_t) cfg_.max_stack_depth) {
+        size_t worst = 0;
+        for (size_t i = 1; i < stack_.size(); ++i) {
+            if (stack_[i].importance < stack_[worst].importance) {
+                worst = i;
+            }
+        }
+        to_drop.push_back(stack_[worst].chunk_id);
+        stack_.erase(stack_.begin() + worst);
+    }
+    return to_drop;
+}
+
+size_t llama_forthllm_stack::size() const {
+    return stack_.size();
+}
+
+const llama_forthllm_chunk_info & llama_forthllm_stack::at(size_t i) const {
+    return stack_.at(i);
+}
+
+llama_forthllm_squeezer::llama_forthllm_squeezer(size_t output_dim, uint32_t seed)
+    : output_dim_(output_dim), seed_(seed) {
+    if (output_dim == 0) {
+        throw std::runtime_error("forthllm: squeezer output_dim must be > 0");
+    }
+}
+
+std::vector<float> llama_forthllm_squeezer::project(const std::vector<float> & embedding) const {
+    std::mt19937 gen(seed_);
+    std::normal_distribution<float> dist(0.0f, 1.0f / std::sqrt((float) output_dim_));
+    std::vector<float> result(output_dim_, 0.0f);
+    for (auto & r : result) {
+        for (size_t j = 0; j < embedding.size(); ++j) {
+            r += dist(gen) * embedding[j];
+        }
+    }
+    return result;
+}
+
+std::string llama_forthllm_squeezer::squeeze(const std::vector<float> & embedding) const {
+    const std::vector<float> projected = project(embedding);
+
+    // 8-bit quantization with a per-vector min/max scale (real KV data is not
+    // confined to [-1, 1])
+    float lo = projected.front();
+    float hi = projected.front();
+    for (float x : projected) {
+        lo = std::min(lo, x);
+        hi = std::max(hi, x);
+    }
+    const float scale = (hi > lo) ? 255.0f / (hi - lo) : 0.0f;
+    std::string bytes(projected.size(), '\0');
+    for (size_t i = 0; i < projected.size(); ++i) {
+        bytes[i] = (char) (uint8_t) std::lround((projected[i] - lo) * scale);
+    }
+
+    std::string blob = llama_forthllm_bwt_transform(bytes);
+    blob.append(reinterpret_cast<const char *>(&lo), sizeof(lo));
+    blob.append(reinterpret_cast<const char *>(&hi), sizeof(hi));
+    return blob;
+}
+
+std::vector<float> llama_forthllm_squeezer::expand(const std::string & compressed) const {
+    if (compressed.size() < 8) {
+        throw std::runtime_error("forthllm: invalid squeezer blob");
+    }
+    const size_t n_bwt = compressed.size() - 8;
+    float lo, hi;
+    std::memcpy(&lo, compressed.data() + n_bwt, sizeof(lo));
+    std::memcpy(&hi, compressed.data() + n_bwt + sizeof(hi), sizeof(hi));
+    const std::string bytes = llama_forthllm_bwt_invert(compressed.substr(0, n_bwt));
+    const float scale = (hi > lo) ? (hi - lo) / 255.0f : 0.0f;
+    std::vector<float> out(bytes.size());
+    for (size_t i = 0; i < bytes.size(); ++i) {
+        out[i] = lo + (float) (uint8_t) bytes[i] * scale;
+    }
+    return out;
+}
+
+size_t llama_forthllm_squeezer::output_dim() const {
+    return output_dim_;
+}
+
+std::string llama_forthllm_bwt_transform(const std::string & input) {
+    const size_t n = input.size();
+    if (n == 0) {
+        return "";
+    }
+    // sort the rotations; the start index breaks ties so the transform is
+    // invertible for any byte content (no unique sentinel needed)
+    std::vector<size_t> order(n);
+    std::iota(order.begin(), order.end(), 0);
+    std::sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+        // compare as uint8_t: char is signed on most platforms, and signed
+        // comparison corrupts the rotation order for bytes >= 128 (invert()
+        // assumes the unsigned byte order)
+        for (size_t i = 0; i < n; ++i) {
+            const uint8_t ca = (uint8_t) input[(a + i) % n];
+            const uint8_t cb = (uint8_t) input[(b + i) % n];
+            if (ca != cb) {
+                return ca < cb;
+            }
+        }
+        return a < b;
+    });
+    std::string out(n, '\0');
+    for (size_t r = 0; r < n; ++r) {
+        out[r] = input[(order[r] + n - 1) % n];
+    }
+    // store the row of the original string (rotation 0) for invert()
+    uint32_t r0 = 0;
+    for (size_t r = 0; r < n; ++r) {
+        if (order[r] == 0) {
+            r0 = (uint32_t) r;
+            break;
+        }
+    }
+    out.append(reinterpret_cast<const char *>(&r0), sizeof(r0));
+    return out;
+}
+
+std::string llama_forthllm_bwt_invert(const std::string & blob) {
+    if (blob.size() < sizeof(uint32_t)) {
+        throw std::runtime_error("forthllm: invalid BWT blob");
+    }
+    const size_t n = blob.size() - sizeof(uint32_t);
+    const std::string & L = blob.substr(0, n);
+    uint32_t r0;
+    std::memcpy(&r0, blob.data() + n, sizeof(r0));
+    if (r0 >= n) {
+        throw std::runtime_error("forthllm: invalid BWT row index");
+    }
+    // LF mapping: LF(r) = C[L[r]] + Occ(L[r], r), where C[c] is the number of
+    // characters smaller than c and Occ counts c in L[0..r)
+    std::array<uint32_t, 256> count{};
+    for (char c : L) {
+        count[(uint8_t) c]++;
+    }
+    std::array<uint32_t, 256> C{};
+    uint32_t acc = 0;
+    for (int c = 0; c < 256; ++c) {
+        C[c] = acc;
+        acc += count[c];
+    }
+    std::vector<uint32_t> occ_before(n, 0);
+    std::array<uint32_t, 256> cnt{};
+    for (size_t r = 0; r < n; ++r) {
+        const uint8_t c = (uint8_t) L[r];
+        occ_before[r] = cnt[c];
+        cnt[c]++;
+    }
+    std::string out(n, '\0');
+    uint32_t r = r0;
+    for (size_t i = n; i-- > 0;) {
+        const uint8_t c = (uint8_t) L[r];
+        out[i] = (char) c;
+        r = C[c] + occ_before[r];
+    }
+    return out;
+}
