+int llama_forthllm_compact(
+        struct llama_context * ctx,
+        int32_t seq_id,
+        const struct llama_forthllm_params * params,
+        struct llama_forthllm_chunk_range * chunk_info,
+        int32_t n_chunk_max) {
+    if (!ctx || !params) {
+        return -1;
+    }
+
+    if (chunk_info && n_chunk_max < 0) {
+        n_chunk_max = 0;
+    }
+
+    auto * memory = (llama_memory_i *) ctx->get_memory();
+    if (!memory) {
+        LLAMA_LOG_WARN("%s: no memory in the context\n", __func__);
+        return -1;
+    }
+
+    llama_kv_cache * kv = dynamic_cast<llama_kv_cache *>(memory);
+    llama_memory_recurrent * recr = nullptr;
+    if (!kv) {
+        // hybrid models (attention + recurrent layers) wrap the attention cache
+        auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory);
+        if (hybrid) {
+            kv   = hybrid->get_mem_attn();
+            recr = hybrid->get_mem_recr();
+        }
+    }
+    if (!kv) {
+        LLAMA_LOG_WARN("%s: not supported: the context memory does not expose a full-attention KV cache\n", __func__);
+        return -1;
+    }
+
+    std::vector<struct llama_forthllm_chunk_range> chunks;
+    const int n_freed = kv->forthllm_compact((llama_seq_id) seq_id, *params, chunks);
+
+    if (n_freed > 0 && recr) {
+        // keep the recurrent state's position bookkeeping in sync with the
+        // compacted attention cache (the running state itself is
+        // position-independent, only the pos field is shifted)
+        recr->seq_add((llama_seq_id) seq_id, 0, -1, -(llama_pos) n_freed);
+    }
+
+    if (chunk_info) {
+        const size_t n = std::min((size_t) n_chunk_max, chunks.size());
+        std::copy(chunks.begin(), chunks.begin() + n, chunk_info);
+    }
+
+    return n_freed;
+}
