+// read one cache row (n elements, starting at the row's first element) into f32
+static bool forthllm_read_row(ggml_type type, const void * row, float * dst, int64_t n) {
+    if (type == GGML_TYPE_F32) {
+        std::memcpy(dst, row, (size_t) n * sizeof(float));
+        return true;
+    }
+    const auto * traits = ggml_get_type_traits(type);
+    if (traits && traits->to_float) {
+        traits->to_float(row, dst, n);
+        return true;
+    }
+    return false;
+}
+
+// write one f32 row into the cache (n elements, starting at the row's first element)
+static bool forthllm_write_row(ggml_type type, const float * src, void * row, int64_t n) {
+    if (type == GGML_TYPE_F32) {
+        std::memcpy(row, src, (size_t) n * sizeof(float));
+        return true;
+    }
+    const auto * traits = ggml_get_type_traits(type);
+    if (traits && traits->from_float_ref) {
+        traits->from_float_ref(src, row, n);
+        return true;
+    }
+    return false;
+}
+
+int llama_kv_cache::forthllm_compact(
+        llama_seq_id seq_id,
+        const struct llama_forthllm_params & params,
+        std::vector<struct llama_forthllm_chunk_range> & chunks) {
+    chunks.clear();
+
+    auto fail = [&](const char * msg) -> int {
+        LLAMA_LOG_WARN("%s: %s\n", __func__, msg);
+        return -1;
+    };
+
+    if (other) {
+        return fail("not supported: shared/mirrored KV cache");
+    }
+    if (swa_type != LLAMA_SWA_TYPE_NONE) {
+        return fail("not supported: sliding-window attention cache");
+    }
+    if (v_trans) {
+        return fail("not supported: transposed V cache (enable flash attention)");
+    }
+    if (!get_can_shift()) {
+        return fail("not supported: the cache does not support K-shift");
+    }
+    if (params.chunk_size <= 0 || params.summary_dim <= 0) {
+        return fail("invalid params: chunk_size and summary_dim must be > 0");
+    }
+    llama_forthllm_summary_method method;
+    try {
+        method = llama_forthllm_summary_method_from_str(params.summary_method ? params.summary_method : "attention");
+    } catch (const std::exception & e) {
+        return fail(e.what());
+    }
+    // validate the eviction policy (all policies currently drop the oldest chunks;
+    // importance-based eviction is future work)
+    try {
+        llama_forthllm_eviction_from_str(params.eviction ? params.eviction : "lru");
+    } catch (const std::exception & e) {
+        return fail(e.what());
+    }
+    if (seq_id < 0 || (size_t) seq_id >= seq_to_stream.size()) {
+        return fail("invalid seq_id");
+    }
+
+    const uint32_t s = seq_to_stream[seq_id];
+    auto & cells = v_cells[s];
+    auto & head  = v_heads[s];
+
+    if (cells.get_used() == 0) {
+        return 0;
+    }
+
+    // the KV tensors must be host-resident (the rows are read/written directly)
+    for (const auto & layer : layers) {
+        if ((layer.k && !ggml_backend_buffer_is_host(layer.k->buffer)) ||
+            (layer.v && !ggml_backend_buffer_is_host(layer.v->buffer))) {
+            return fail("not supported: the KV cache must be on the host (offload the layers to the CPU)");
+        }
+    }
+
+    // collect the sequence's cells in position order
+    const llama_pos pos_min = cells.seq_pos_min(seq_id);
+    std::vector<uint32_t> idxs;
+    for (uint32_t i = cells.used_min(); i < cells.used_max_p1(); ++i) {
+        if (cells.seq_has(i, seq_id)) {
+            idxs.push_back(i);
+        }
+    }
+    std::sort(idxs.begin(), idxs.end(), [&](uint32_t a, uint32_t b) {
+        return cells.pos_get(a) < cells.pos_get(b);
+    });
+
+    const uint32_t C = (uint32_t) params.chunk_size;
+    const uint32_t S = std::min((uint32_t) params.summary_dim, C);
+
+    if (idxs.size() <= C) {
+        return 0; // the whole sequence fits in the raw window
+    }
+
+    // layout: keep the last C cells raw; compact the rest into full chunks of C
+    // (a leading remainder smaller than C stays raw)
+    const uint32_t n_compact = idxs.size() - C;
+    const uint32_t n_chunks  = n_compact / C;
+    const uint32_t n_skip    = n_compact % C;
+
+    // max_stack_depth: keep at most this many summarized chunks; the oldest chunks
+    // beyond the limit are dropped from the context entirely (no summary rows)
+    const uint32_t n_keep = (params.max_stack_depth > 0)
+        ? std::min(n_chunks, (uint32_t) params.max_stack_depth)
+        : n_chunks;
+    const uint32_t n_drop = n_chunks - n_keep;
+
+    int n_freed_total = 0;
+
+    for (uint32_t c = 0; c < n_chunks; ++c) {
+        const uint32_t i0 = n_skip + c * C;
+
+        // the chunk's cells must be contiguous in position space
+        llama_pos p0 = cells.pos_get(idxs[i0]);
+        bool ok = true;
+        for (uint32_t j = 0; j < C; ++j) {
+            if (cells.pos_get(idxs[i0 + j]) != p0 + (llama_pos) j) {
+                ok = false;
+                break;
+            }
+        }
+        // and exclusively owned by this sequence (shared cells cannot be freed)
+        if (ok) {
+            for (uint32_t j = 0; j < C; ++j) {
+                if (cells.seq_count(idxs[i0 + j]) != 1) {
+                    ok = false;
+                    break;
+                }
+            }
+        }
+        if (!ok) {
+            continue; // skip this chunk, keep it raw
+        }
+
+        // the oldest chunks beyond max_stack_depth are dropped from the context
+        // entirely: all C cells are freed (no summary rows) and the subsequent cells
+        // shift left by C
+        if (c < n_drop) {
+            for (uint32_t j = 0; j < C; ++j) {
+                if (cells.seq_rm(idxs[i0 + j], seq_id) && idxs[i0 + j] < head) {
+                    head = idxs[i0 + j];
+                }
+            }
+            const llama_pos d = -(llama_pos) C;
+            for (uint32_t j = i0 + C; j < idxs.size(); ++j) {
+                cells.pos_add(idxs[j], d);
+            }
+            chunks.push_back({
+                pos_min + (llama_pos) (n_skip + c * C),
+                (int32_t) C,
+                (int32_t) C, // all cells freed (dropped, not summarized)
+            });
+            n_freed_total += (int) C;
+            continue;
+        }
+
+        // summarize the chunk's K/V rows into S rows, per layer
+        bool done = true;
+        for (auto & layer : layers) {
+            if (!layer.k || !layer.v) {
+                done = false;
+                break;
+            }
+
+            const uint32_t il = layer.il;
+            const uint32_t n_head_kv  = hparams.n_head_kv(il);
+            const uint32_t head_dim_k = hparams.n_embd_head_k(il);
+            const uint32_t head_dim_v = hparams.n_embd_head_v(il);
+            const uint32_t kv_dim_k   = n_head_kv * head_dim_k;
+            const uint32_t kv_dim_v   = n_head_kv * head_dim_v;
+
+            if (layer.k->ne[0] != (int64_t) kv_dim_k || layer.v->ne[0] < (int64_t) kv_dim_v) {
+                done = false;
+                break;
+            }
+
+            const auto * k = layer.k;
+            const auto * v = layer.v;
+
+            std::vector<float> kbuf((size_t) C * kv_dim_k);
+            std::vector<float> vbuf((size_t) C * kv_dim_v);
+            for (uint32_t j = 0; j < C; ++j) {
+                const uint32_t i = idxs[i0 + j];
+                const void * krow = (const char *) k->data + (size_t) i * k->nb[1] + (size_t) s * k->nb[2];
+                const void * vrow = (const char *) v->data + (size_t) i * v->nb[1] + (size_t) s * v->nb[2];
+                if (!forthllm_read_row(k->type, krow, &kbuf[(size_t) j * kv_dim_k], kv_dim_k) ||
+                    !forthllm_read_row(v->type, vrow, &vbuf[(size_t) j * kv_dim_v], kv_dim_v)) {
+                    done = false;
+                    break;
+                }
+            }
+            if (!done) {
+                break;
+            }
+
+            std::vector<float> ksum((size_t) S * kv_dim_k);
+            std::vector<float> vsum((size_t) S * kv_dim_v);
+            llama_forthllm_summarize(
+                    kbuf.data(), n_head_kv, head_dim_k,
+                    vbuf.data(), n_head_kv, head_dim_v,
+                    C, S, method, ksum, vsum);
+
+            for (uint32_t j = 0; j < S; ++j) {
+                const uint32_t i = idxs[i0 + j];
+                void * krow = (char *) k->data + (size_t) i * k->nb[1] + (size_t) s * k->nb[2];
+                void * vrow = (char *) v->data + (size_t) i * v->nb[1] + (size_t) s * v->nb[2];
+                if (!forthllm_write_row(k->type, &ksum[(size_t) j * kv_dim_k], krow, kv_dim_k) ||
+                    !forthllm_write_row(v->type, &vsum[(size_t) j * kv_dim_v], vrow, kv_dim_v)) {
+                    done = false;
+                    break;
+                }
+            }
+            if (!done) {
+                break;
+            }
+        }
+        if (!done) {
+            return fail("unsupported KV cache data type");
+        }
+
+        // free the cells beyond the S summary rows
+        for (uint32_t j = S; j < C; ++j) {
+            if (cells.seq_rm(idxs[i0 + j], seq_id) && idxs[i0 + j] < head) {
+                head = idxs[i0 + j];
+            }
+        }
+
+        // shift the subsequent cells left by (C - S); the K-shift mechanism
+        // re-rotates their keys to the new positions on the next update()
+        const llama_pos d = (llama_pos) S - (llama_pos) C;
+        for (uint32_t j = i0 + C; j < idxs.size(); ++j) {
+            cells.pos_add(idxs[j], d);
+        }
+
+        // report the chunk in the pre-compaction position space
+        chunks.push_back({
+            pos_min + (llama_pos) (n_skip + c * C),
+            (int32_t) C,
+            (int32_t) (C - S),
+        });
+
+        n_freed_total += (int) (C - S);
+    }
+
+    if (n_freed_total > 0) {
